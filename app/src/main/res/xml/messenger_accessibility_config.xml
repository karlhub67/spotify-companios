<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service limited to Messenger.
  - packageNames: Android only delivers events from Messenger to this service.
  - canRetrieveWindowContent: needed to read control labels and to click / set text (no other capability).
  - NOT requested: canPerformGestures (no coordinate taps), key events, touch exploration, screen capture.
  - flagReportViewIds: lets the diagnostic report show control ids (no personal data).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="250"
    android:packageNames="com.facebook.orca" />
